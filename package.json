{
  "name": "flightcost",
  "version": "0.9.0",
  "private": true,
  "description": "Local aircraft ownership and operating cost management",
  "author": "The Thrifty Pilot",
  "main": "build/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run",
    "package": "npm run build && electron-builder --win nsis --x64",
    "smoke": "node scripts/smoke.mjs",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "decimal.js": "10.6.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.thethriftypilot.flightcost",
    "productName": "FlightCost",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "package.json",
      "assets/icon.ico"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "FlightCost-Setup-${version}.${ext}"
    }
  },
  "type": "module"
}